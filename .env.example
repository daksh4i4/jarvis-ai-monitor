APP_NAME=JARVIS AI
# Required by docker-compose.yml; replace with your real DNS name for cloud deployment.
JARVIS_DOMAIN=jarvis.example.com
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JARVIS_API_TOKEN=replace-with-a-long-random-secret
DATABASE_PATH=/data/jarvis.db
# Delta Exchange India public API. This project makes unauthenticated GET requests only.
DELTA_BASE_URL=https://api.india.delta.exchange
DELTA_SYMBOLS=BTCUSD,ETHUSD
DELTA_RESOLUTION=5m
DELTA_LOOKBACK_CANDLES=150
MARKET_POLL_SECONDS=60
SR_PIVOT_WINDOW=3
SR_APPROACH_PCT=0.003
ALERT_COOLDOWN_MINUTES=60
# RSS news polling
NEWS_RSS_URLS=https://www.rbi.org.in/Scripts/RSS.aspx?Id=5
POLL_SECONDS=120
# iPhone push via ntfy iOS app. Use a long, unguessable topic; see README.
NTFY_BASE_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=
# Optional additional HTTPS webhook
ALERT_WEBHOOK_URL=
# Private account integration intentionally remains disabled and unimplemented pending auth verification.
DELTA_READONLY_ENABLED=false
DELTA_API_KEY=
DELTA_API_SECRET=
# Optional local agent relay; leave empty for cloud-only monitoring.
LOCAL_AGENT_URL=
LOCAL_AGENT_TOKEN=
